uint SphereOffset;
uint SphereCount;
float3 WorldPoint(uint i,float3 p){uint b=Instance[i]*3;return float3(dot(WorldRows[b],float4(p,1)),dot(WorldRows[b+1],float4(p,1)),dot(WorldRows[b+2],float4(p,1)));}
float3 LocalVector(uint i,float3 p){uint b=Instance[i]*3;return float3(dot(LocalRows[b].xyz,p),dot(LocalRows[b+1].xyz,p),dot(LocalRows[b+2].xyz,p));}
float3 WorldVector(uint i,float3 p){uint b=Instance[i]*3;return float3(dot(WorldRows[b].xyz,p),dot(WorldRows[b+1].xyz,p),dot(WorldRows[b+2].xyz,p));}

StructuredBuffer<uint4> Tets;
StructuredBuffer<uint4> SkinHinges;
StructuredBuffer<uint4> SkinFaces;
StructuredBuffer<uint> VertexOrder;
StructuredBuffer<float4> Material;
StructuredBuffer<uint2> SurfaceEdges;
StructuredBuffer<float2> EdgeLimits;

StructuredBuffer<uint> Regions;
RWStructuredBuffer<float4> VolumeGradients;
RWStructuredBuffer<float4> ZoneState;
groupshared float3 ZoneSums[64];
StructuredBuffer<float4> Spheres;
StructuredBuffer<float4> ShapePlanes;
StructuredBuffer<float4> ShapeRotations;
StructuredBuffer<float4> ShapeExtents;
StructuredBuffer<float4> SphereStarts;
