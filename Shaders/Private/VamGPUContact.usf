RWBuffer<uint> ContactDispatch;
uint ContactNodeCount;
groupshared float3 ContactMin[64];
groupshared float3 ContactMax[64];
StructuredBuffer<float4> WorldRows;
StructuredBuffer<float4> LocalRows;
RWStructuredBuffer<uint> SelectedPair;
RWStructuredBuffer<float4> ElasticGradient;
