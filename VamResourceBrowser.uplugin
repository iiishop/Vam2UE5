{
  "FileVersion": 3,
  "Version": 5,
  "VersionName": "0.5.0-dev",
  "FriendlyName": "VaM Resource Browser",
  "Description": "Source browser, native character builder, locked editable Morph sets and per-instance shape runtime. Source-reference material and TriAx diagnostics are preserved.",
  "Category": "Editor",
  "CreatedBy": "SmartNPC",
  "EnabledByDefault": false,
  "CanContainContent": true,
  "SupportedTargetPlatforms": [
    "Win64"
  ],
  "Plugins": [
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true,
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "GeometryScripting",
      "Enabled": true,
      "TargetAllowList": [
        "Editor"
      ]
    },
    {
      "Name": "IKRig",
      "Enabled": true
    },
    {
      "Name": "FullBodyIK",
      "Enabled": true
    },
    {
      "Name": "ChaosFlesh",
      "Enabled": true
    },
    {
      "Enabled": true,
      "Name": "ProceduralMeshComponent"
    }
  ],
  "Modules": [
    {
      "Name": "VamCharacterRuntime",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    },
    {
      "Name": "VamResourceBrowser",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit"
    }
  ]
}
